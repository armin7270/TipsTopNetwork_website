{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "composer install --no-dev --optimize-autoloader --no-interaction && npm install --no-audit --no-fund && npm run build"
    },
    "deploy": {
        "startCommand": "bash deploy/start.sh",
        "healthcheckPath": "/up",
        "healthcheckTimeout": 100,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 3
    }
}
