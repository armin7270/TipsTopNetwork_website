APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- اطلاعات مدیر پیش‌فرض (سیدر) ----
# نام کاربری ورود مدیر: admin  |  رمز عبور: admin
ADMIN_USERNAME=admin
ADMIN_PHONE=09120000000
ADMIN_PASSWORD=admin

# ---- دیپلوی (اختیاری) ----
# برای Vercel: APP_STORAGE=/tmp/storage
# APP_STORAGE=
# کلید امنیتی وبهوک NOWPayments (اگر خالی باشد تایید امضا غیرفعال است)
# NOWPAYMENTS_IPN_SECRET=

# ---- هاست اشتراکی (InfinityFree و...) ----
# MySQL هاست را اینجا وارد کنید (به‌جای sqlite)
# DB_CONNECTION=mysql
# DB_HOST=sqlXXX.infinityfree.com
# DB_PORT=3306
# DB_DATABASE=xxx_tipstop
# DB_USERNAME=xxx_user
# DB_PASSWORD=xxx_pass
# QUEUE_CONNECTION=database
# کلید مخفی نقاط کمکی دیپلوی (/deploy/migrate و /deploy/cron) — یک رشته تصادفی طولانی بگذارید
# DEPLOY_KEY=change-me-to-a-long-random-string
